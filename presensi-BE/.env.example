# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Konfigurasi Kantor & Toleransi Lokasi Presensi
OFFICE_NAME="Direktorat Bina Teknik Sumber Daya Air"
OFFICE_LATITUDE=-6.2363976
OFFICE_LONGITUDE=106.8008284
OFFICE_RADIUS_METERS=100
MAX_GPS_ACCURACY_METERS=100

# Telegram Bot Logger Configuration (Real-time Presensi Log)
# 1. Buat Bot melalui @BotFather di Telegram untuk mendapatkan Bot Token
# 2. Dapatkan Chat ID Anda via @userinfobot atau ID Grup Admin (diawali tanda minus -100xxxxxxxx)
# 3. Pastikan Anda sudah klik /start pada bot atau mengundang bot ke grup admin
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Frontend URL Configuration (Untuk redirect tautan reset password)
FRONTEND_URL=http://localhost:5173
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# CORS whitelist frontend Vite (comma-separated untuk beberapa origin)
CORS_ORIGIN=http://localhost:5173
